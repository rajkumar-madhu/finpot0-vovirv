# Server
PORT=4001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_saas?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# API Key Settings
API_KEY_HASH_ROUNDS=12

# Rate Limiting (requests per minute)
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1000

# Logging
LOG_LEVEL=info

# Internal service-to-service auth (must match INTERNAL_SERVICE_KEY in orchestrator)
INTERNAL_SERVICE_KEY=

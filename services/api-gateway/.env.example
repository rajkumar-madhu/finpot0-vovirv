# Server
PORT=4000
NODE_ENV=development

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379

# JWT (for token validation)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Downstream services
AUTH_SERVICE_URL=http://localhost:4001
STT_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003
FLOWISE_URL=http://localhost:3000
ORCHESTRATOR_URL=http://localhost:4002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Twilio (for voice call webhooks)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15625742095
TWILIO_DEFAULT_TENANT_ID=default-tenant

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8003
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO

# PostgreSQL
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_saas

# Embedding model
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_DIMENSION=384

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Search
RAG_PGVECTOR_MIN_SCORE=0.5
RAG_PGVECTOR_DEFAULT_TOP_K=5

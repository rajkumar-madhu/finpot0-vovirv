# Server
TTS_HOST=0.0.0.0
TTS_PORT=8002
TTS_ENVIRONMENT=development
TTS_LOG_LEVEL=INFO

# IndicF5 (GPU primary — enable for production with GPU)
TTS_INDICF5_ENABLED=false
TTS_INDICF5_DEVICE=cuda
TTS_INDICF5_MODEL=ai4bharat/IndicF5-7B
TTS_INDICF5_PROMPTS_DIR=/app/prompts

# Piper (CPU fallback)
TTS_PIPER_MODEL=en_US-lessac-medium
TTS_PIPER_DATA_DIR=/app/models

# Redis (optional)
TTS_REDIS_URL=redis://localhost:6379

# Server
PORT=4003
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_saas

# Redis
REDIS_URL=redis://localhost:6379

# JWT (for auth middleware)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Email credential encryption (32 bytes hex for AES-256)
EMAIL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# IMAP Polling
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_MAX_EMAILS_PER_POLL=100

# SMTP Queue
SMTP_QUEUE_CONCURRENCY=5
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=60

# Attachments
ATTACHMENT_STORAGE_PATH=./data/attachments
ATTACHMENT_MAX_SIZE_MB=25

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
ORCHESTRATOR_URL=http://localhost:4002

# Rate Limiting (requests per minute)
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1000

# Logging
LOG_LEVEL=info
